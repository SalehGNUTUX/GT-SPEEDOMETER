{
  "version": 8,
  "name": "GT-SPEEDOMETER — shortbread محلّيّ",
  "glyphs": "asset://map/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "src": {
      "type": "vector",
      "url": "__PMTILES_URL__",
      "attribution": "© OpenStreetMap · shortbread"
    }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#0B1116" } },
    {
      "id": "ocean",
      "type": "fill",
      "source": "src",
      "source-layer": "ocean",
      "paint": { "fill-color": "#0E2E3A" }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "src",
      "source-layer": "land",
      "paint": { "fill-color": "#141D24" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "src",
      "source-layer": "water_polygons",
      "paint": { "fill-color": "#0E2E3A" }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "src",
      "source-layer": "water_lines",
      "minzoom": 9,
      "paint": {
        "line-color": "#12455A",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.4, 16, 3]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "src",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": { "fill-color": "#1E2C35" }
    },
    {
      "id": "streets-minor",
      "type": "line",
      "source": "src",
      "source-layer": "streets",
      "minzoom": 12,
      "filter": [
        "in", ["get", "kind"],
        ["literal", ["service", "track", "path", "footway", "cycleway", "living_street", "pedestrian"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#2A3A44",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.4, 18, 5]
      }
    },
    {
      "id": "streets-normal",
      "type": "line",
      "source": "src",
      "source-layer": "streets",
      "minzoom": 10,
      "filter": [
        "in", ["get", "kind"],
        ["literal", ["residential", "unclassified", "tertiary", "tertiary_link"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#3C525F",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 18, 7]
      }
    },
    {
      "id": "streets-major",
      "type": "line",
      "source": "src",
      "source-layer": "streets",
      "filter": [
        "in", ["get", "kind"],
        ["literal", ["primary", "primary_link", "secondary", "secondary_link", "trunk", "trunk_link"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#587a8c",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.6, 18, 10]
      }
    },
    {
      "id": "streets-motorway",
      "type": "line",
      "source": "src",
      "source-layer": "streets",
      "filter": ["in", ["get", "kind"], ["literal", ["motorway", "motorway_link"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#7FA3B5",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.9, 18, 13]
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "src",
      "source-layer": "boundaries",
      "filter": ["<=", ["get", "admin_level"], 4],
      "paint": {
        "line-color": "#46606E",
        "line-dasharray": [3, 2],
        "line-width": 0.9
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "src",
      "source-layer": "street_labels",
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Arabic Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#C8D8E0",
        "text-halo-color": "#070B0E",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "src",
      "source-layer": "place_labels",
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Arabic Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          4, ["match", ["get", "kind"], ["country", "state"], 13, 10],
          10, ["match", ["get", "kind"], ["city", "town"], 18, 13],
          14, 20
        ],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#EAF2F6",
        "text-halo-color": "#070B0E",
        "text-halo-width": 1.5
      }
    }
  ]
}
