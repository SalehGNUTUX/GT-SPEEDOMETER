{
  "version": 8,
  "name": "GT-SPEEDOMETER — shortbread محلّيّ",
  "glyphs": "asset://map/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "src": {
      "type": "vector",
      "url": "__PMTILES_URL__",
      "attribution": "© OpenStreetMap · shortbread"
    }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#1A2430" } },
    {
      "id": "ocean",
      "type": "fill",
      "source": "src",
      "source-layer": "ocean",
      "paint": { "fill-color": "#08131C" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "src",
      "source-layer": "land",
      "paint": {
        "fill-color": [
          "match", ["get", "kind"],
          ["forest", "wood"], "#1B2E24",
          ["park", "garden", "grass", "grassland", "meadow", "village_green", "playground", "pitch", "golf_course", "allotments"], "#1E3128",
          ["farmland", "farmyard", "orchard", "vineyard", "greenhouse_horticulture"], "#242C22",
          ["scrub", "heath", "bare_rock", "scree", "sand", "beach"], "#2A2A24",
          ["residential", "commercial", "retail"], "#212B36",
          ["industrial", "brownfield", "greenfield", "quarry", "railway"], "#242A31",
          ["cemetery", "hospital", "university", "college", "school", "military"], "#232D33",
          "#1E2833"
        ],
        "fill-opacity": 0.9
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "src",
      "source-layer": "water_polygons",
      "paint": { "fill-color": "#0D2230" }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "src",
      "source-layer": "water_lines",
      "paint": {
        "line-color": "#123B4F",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.4, 16, 3]
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "src",
      "source-layer": "boundaries",
      "filter": ["all", ["<=", ["get", "admin_level"], 4], ["!", ["get", "maritime"]]],
      "paint": {
        "line-color": "#4E6474",
        "line-dasharray": [3, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.6, 10, 1.4]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "src",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": { "fill-color": "#2A3541" }
    },
    {
      "id": "streets-minor",
      "type": "line",
      "source": "src",
      "source-layer": "streets",
      "minzoom": 13,
      "filter": [
        "match", ["get", "kind"],
        ["service", "track", "path", "footway", "steps", "cycleway", "bridleway", "living_street", "pedestrian"],
        true, false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#3A4A57",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.4, 18, 4]
      }
    },
    {
      "id": "streets-residential",
      "type": "line",
      "source": "src",
      "source-layer": "streets",
      "filter": [
        "match", ["get", "kind"],
        ["residential", "unclassified"], true, false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#54697A",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 1.6, 18, 7]
      }
    },
    {
      "id": "streets-tertiary",
      "type": "line",
      "source": "src",
      "source-layer": "streets",
      "filter": ["match", ["get", "kind"], ["tertiary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#6B8291",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2, 18, 8]
      }
    },
    {
      "id": "railways",
      "type": "line",
      "source": "src",
      "source-layer": "streets",
      "filter": ["match", ["get", "kind"], ["rail", "tram", "light_rail", "subway", "narrow_gauge", "funicular"], true, false],
      "paint": {
        "line-color": "#4A5560",
        "line-dasharray": [2, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 18, 2.5]
      }
    },
    {
      "id": "streets-secondary",
      "type": "line",
      "source": "src",
      "source-layer": "streets",
      "filter": ["match", ["get", "kind"], ["secondary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#8098A8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.6, 14, 2.6, 18, 9]
      }
    },
    {
      "id": "streets-primary",
      "type": "line",
      "source": "src",
      "source-layer": "streets",
      "filter": ["match", ["get", "kind"], ["primary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#9BB2C0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.7, 14, 3.2, 18, 10]
      }
    },
    {
      "id": "streets-trunk",
      "type": "line",
      "source": "src",
      "source-layer": "streets",
      "filter": ["match", ["get", "kind"], ["trunk"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#C2A76A",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.8, 14, 3.6, 18, 11]
      }
    },
    {
      "id": "streets-motorway",
      "type": "line",
      "source": "src",
      "source-layer": "streets",
      "filter": ["match", ["get", "kind"], ["motorway"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#E0C176",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 1, 14, 4.2, 18, 13]
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "src",
      "source-layer": "street_labels",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"], ["get", "ref"]],
        "text-font": ["Noto Sans Arabic Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#C8D8E0",
        "text-halo-color": "#0A1017",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "src",
      "source-layer": "place_labels",
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Arabic Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          4, ["match", ["get", "kind"], ["country", "state", "capital", "state_capital"], 13, 10],
          10, ["match", ["get", "kind"], ["city", "town", "capital", "state_capital"], 18, 13],
          14, 20
        ],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#EAF2F6",
        "text-halo-color": "#0A1017",
        "text-halo-width": 1.5
      }
    }
  ]
}
