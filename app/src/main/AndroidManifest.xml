<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- الموقع: ضروري لقياس السرعة والمسافة -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- الكاميرا والصوت: لتسجيل الرحلة -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- بلاطات الخريطة في قسم الرحلات فقط. القياس والتسجيل يعملان دون شبكة. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- الخدمة الأمامية: أندرويد 14 فما فوق يوجب التصريح بنوعها -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.location.gps" android:required="true" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        رؤية حزم OsmAnd. على أندرويد 11 فما فوق لا يرى `PackageManager` تطبيقًا
        غير مُعلَنٍ هنا، فيقول «غير مثبَّت» عن تطبيقٍ قائم ويتعذّر الربط بخدمته.
        الثلاثة نسخٌ متوازية: الكاملة والمجّانيّة ونسخة المطوّرين.
    -->
    <queries>
        <package android:name="net.osmand.plus" />
        <package android:name="net.osmand" />
        <package android:name="net.osmand.dev" />
    </queries>

    <application
        android:name=".SpeedoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GTSpeedometer">

        <!--
            صورة في صورة: المغادرة أثناء رحلةٍ أو تسجيل تُبقي السرعة ظاهرة.
            و`configChanges` تزيد `smallestScreenSize|density` على ما كان، لأنّ
            الانكماش إلى النافذة يبدّلهما أيضًا؛ ولولاهما أُعيد بناء النشاط عند كلّ
            دخولٍ وخروج فيومض التسجيل ويعود التبويب إلى أوّله.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
            android:theme="@style/Theme.GTSpeedometer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TripService"
            android:exported="false"
            android:foregroundServiceType="location|camera" />

        <!-- مربّع لوحة الإعدادات السريعة -->
        <service
            android:name=".service.SpeedTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_speed"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            لمشاركة ملفّات مجلد التطبيق على أندرويد 9 فما دون، وهو نفسه الذي يمنح
            OsmAnd قراءةَ ملفّ الرحلة حين نطلب منه رسم خريطتها.

            ولماذا لا مزوّدٌ ثانٍ بسلطةٍ خاصّة بالجسر؟ لأنّ عنصرَي `<provider>`
            باسم الصنف نفسه يُدمجان عند التركيب في `ActivityThread`: الثاني يجد
            سجلّ الأوّل باسم مكوّنه فيتخلّى عن سجلّه هو، فيصير أيّ المسارَين يخدم
            أيّ سلطةٍ أمرًا غير محسوم. وفصلُهما حقًّا يوجب صنفًا وارثًا لـ
            `FileProvider` باسمٍ مغاير، وذلك ثمنٌ لا يشتري شيئًا: الإذن يُمنح على
            عنوان ملفٍّ بعينه لا على المزوّد كلّه، وهذه السلطة نفسها هي التي يمرّ
            بها زرّ «فتح في OsmAnd» منذ 0.4.0.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
