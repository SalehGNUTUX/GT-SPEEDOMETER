# fastlane — رفعُ الرزمة وبيانات المتجر إلى غوغل بلاي بأمرٍ واحد.
#
# ولماذا `Gemfile` لا `gem install fastlane`؟ لأنّ النسخة تُثبَّت ههنا لا في
# النظام، فلا تُفسد روبيَّ الجهاز ولا تتبدّل تحت المشروع. و`Gemfile.lock` يُودَع
# في المستودع: البناء الذي لا يُعاد إنتاجه ليس بناءً.
#
#     bundle config set --local path vendor/bundle
#     bundle install
#     bundle exec fastlane play_internal
source "https://rubygems.org"

gem "fastlane", ">= 2.228"
