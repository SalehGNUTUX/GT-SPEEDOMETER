# ---------------------------------------------------------------------------
#  هويّةُ التطبيق عند غوغل بلاي، ومفتاحُ الوصول إليه
# ---------------------------------------------------------------------------
#
#  **المعرّفُ معرّفُ نكهة المتجر لا معرّف النكهة الحرّة.** هما تطبيقان مستقلّان،
#  ورفعُ رزمةٍ إلى معرّفٍ غير معرّفها يُرفض — وإن قُبل كان أسوأ.
package_name "net.gnutux.speedometer.play"

#  ملفُّ حساب الخدمة (JSON) الذي يأذن بالرفع.
#
#  **لا يدخل المستودع أبدًا**: هو مفتاحُ نشرٍ باسمك، ومن ملكه رفع ما شاء إلى
#  صفحتك. يُنشأ من Play Console ← الإعدادات ← وصول واجهة برمجة التطبيقات، ويُمنح
#  صلاحيّة «إصدار التطبيقات» وحدها لا أكثر.
#
#  ويُقرأ من متغيّر البيئة إن وُجد، وإلّا من جذر المشروع:
#      GT_PLAY_JSON=/مسار/آمن/play-api.json  bundle exec fastlane play_internal
#
#  والمسارُ من جذر المشروع لا من مجلّد العمل: fastlane يشتغل من داخل `fastlane/`.
json_key_file(ENV["GT_PLAY_JSON"] || File.expand_path("../play-api.json", __dir__))
